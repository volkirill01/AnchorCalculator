@model UI.AnchorCalculator.ViewModels.LoginViewModel
@{ ViewData["Title"] = "Вход"; }

<div class="container py-5">
	<div class="row justify-content-center">
		<div class="col-12 col-md-7 col-lg-5 col-xl-4">
			<div class="card shadow-sm">
				<div class="card-body p-4">
					<h2 class="text-center mb-4">Вход в приложение</h2>

					<form method="post" asp-controller="Account" asp-action="Login">
						<input asp-for="ReturnUrl" type="hidden" />
						<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

						<div class="mb-3">
							<label asp-for="EmailLogin" class="form-label"></label>
							<input asp-for="EmailLogin" class="form-control" />
							<span asp-validation-for="EmailLogin" class="text-danger"></span>
						</div>

						<div class="mb-3">
							<label asp-for="Password" class="form-label"></label>
							<input asp-for="Password" class="form-control" />
							<span asp-validation-for="Password" class="text-danger"></span>
						</div>

						<div class="form-check mb-3">
							<input asp-for="RememberMe" class="form-check-input" />
							<label asp-for="RememberMe" class="form-check-label"></label>
						</div>

						<button type="submit" class="btn btn-dark w-100">Войти</button>
					</form>
				</div>
			</div>
		</div>
	</div>
</div>
