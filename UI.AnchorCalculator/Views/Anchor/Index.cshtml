				type: 'POST',
				conntenttype: 'json',
				data:
				{
					'materialId': materialIdToDB,
					'diameterMillimeters': diameterMillimetersToDB,
					'lengthMillimeters': lengthMillimetersToDB,
					'threadDiameterMillimeters': threadDiameterMillimetersToDB,
					'threadLengthMillimeters': threadLengthMillimetersToDB,
					'threadSecondLengthMillimeters': threadSecondLengthMillimetersToDB,
					'threadStepMillimeters': threadStepMillimetersToDB,
					'quantity': quantityToDB,
					'bendLengthMillimeters': bendLengthMillimetersToDB,
					'bendRadiusMillimeters': bendRadiusMillimetersToDB,
					'priceSom_SingleAnchor': priceSom_SingleAnchorToDB,
					'priceSom_Total': priceSom_TotalToDB,
					'billetLengthMillimeters': billetLengthMillimetersToDB,
					'weightKg_SingleAnchor': weightKg_SingleAnchorToDB,
					'weightKg_Total': weightKg_TotalToDB,
					'svgElement' : svgToDB,
					'sebesSom_SingleAnchor': sebesSom_SingleAnchorToDB,
					'sebesSom_Total': sebesSom_TotalToDB,
					'orderNumber': orderNumberToDB,
					'kind' : kindToDB,
					'priceSom_ProductionThread_Total' : priceSom_ProductionThread_TotalToDB,
					'priceSom_ProductionBend_Total' : priceSom_ProductionBend_TotalToDB,
					'priceSom_ProductionBandSaw_Total' : priceSom_ProductionBandSaw_TotalToDB,
					'priceSom_Material_Total': priceSom_Material_TotalToDB,
					'pathRollerLengthMillimeters': pathRollerLengthMillimetersToDB,
					'rollerPathLengthMillimetersBeforeEnd': rollerPathLengthMillimetersBeforeEndToDB,
					'threadProductionId': threadProductionIdToDB,
					'productionHours_Thread': productionHours_ThreadToDB,
					'productionHours_Bend': productionHours_BendToDB,
					'productionHours_BandSaw': productionHours_BandSawToDB,
					'fullLengthMeters': fullLengthMetersToDB,
					'hasCuttingThread': hasCuttingThreadToDB,
					'withoutBindThreadDiamMaterial': withoutBindThreadDiamMaterialToDB,
					'secondLengthMillimeters': secondLengthMillimetersToDB
				},
				success: function (response)
				{
					if (response.success)
					{
						let btn_drawing_pdf = document.getElementById("btn_drawing_pdf");
						btn_drawing_pdf.className = 'btn btn-dark';
						btn_drawing_pdf.disabled = false;
						btn_drawing_pdf.onclick = () => PrintDraw(response.id);

						let btn_blank_pdf = document.getElementById("btn_blank_pdf");
						btn_blank_pdf.className = 'btn btn-dark';
						btn_blank_pdf.disabled = false;
						btn_blank_pdf.onclick = () => PrintBlank(response.id);

						document.getElementById("liveToastBtn").disabled = true;
						let toastTrigger = document.getElementById('liveToastBtn')
						let toastLiveExample = document.getElementById('liveToast')
						if (toastTrigger)
						{
							let toast = new bootstrap.Toast(toastLiveExample)
							toast.show()
						}
					}
				}
			});
		}
	</script>

	<script type="text/javascript" src="~/js/print.js"></script>
	<script src="~/lib/jquery/jasonday-printThis-23be1f8/printThis.js"></script>
	<script type="text/javascript" src="~/js/printDrawBlank.js"></script>
}
